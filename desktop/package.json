{
  "name": "boom-boom-bam-desktop",
  "productName": "Boom Boom Bam",
  "version": "1.0.0",
  "description": "Always-on-top window for the Boom Boom Bam to-do list",
  "main": "main.js",
  "author": "Qafa",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.qafa17.boomboombam",
    "productName": "Boom Boom Bam",
    "files": ["main.js", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "createDesktopShortcut": true, "runAfterFinish": true }
  }
}
